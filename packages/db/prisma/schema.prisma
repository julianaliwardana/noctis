generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String            @id @default(cuid())
  email            String            @unique
  passwordHash     String
  /// Bumped to revoke every refresh token issued so far (sign out everywhere).
  tokenVersion     Int               @default(0)
  name             String?
  dateOfBirth      DateTime?
  /// Take-home pay per month in IDR, typed in by the user. Powers "can I afford X?".
  monthlyIncome    Float?
  /// Day of the month salary is expected (1-31). Set: budgets and the overview run from salary to
  /// salary instead of by calendar month. Null: calendar months.
  payday           Int?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  tasks            Task[]
  habits           Habit[]
  expenses         Expense[]
  categories       Category[]
  vaultKey         VaultKey?
  vaultItems       VaultItem[]
  nudges           Nudge[]
  pomodoroSessions PomodoroSession[]
  pushSubscription PushSubscription?
  conversations    Conversation[]
  budgets          Budget[]
  subscriptions    Subscription[]
  oauthCodes       OAuthCode[]
  oauthGrants      OAuthGrant[]
  agentRuns        AgentRun[]
}

model Conversation {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id])
  title     String
  messages  ChatMessage[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([userId, updatedAt])
}

model ChatMessage {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        String
  actionLabel    String?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

model Task {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  title       String
  notes       String?
  dueAt       DateTime?
  completed   Boolean   @default(false)
  completedAt DateTime?
  recurrence  String?
  createdAt   DateTime  @default(now())
}

model Habit {
  id            String     @id @default(cuid())
  userId        String
  user          User       @relation(fields: [userId], references: [id])
  name          String
  note          String?
  daysOfWeek    Int[]      @default([0, 1, 2, 3, 4, 5, 6])
  endDate       DateTime?
  color         String     @default("#4b8b5f")
  streak        Int        @default(0)
  longestStreak Int        @default(0)
  logs          HabitLog[]
  createdAt     DateTime   @default(now())
}

model HabitLog {
  id        String   @id @default(cuid())
  habitId   String
  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  date      DateTime
  note      String?
  createdAt DateTime @default(now())
}

model Category {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  name      String
  color     String   @default("#2a78d6")
  createdAt DateTime @default(now())
  budget    Budget?

  @@unique([userId, name])
}

/// A standing monthly limit for one category. Deleting the category deletes its budget.
model Budget {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  categoryId      String   @unique
  category        Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  monthlyLimit    Float
  /// Month ("YYYY-MM", Asia/Jakarta) whose 80% push already went out. One push per threshold per month.
  alerted80Month  String?
  alerted100Month String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
}

/// A subscription the user expects to be charged for. Bank titles hide the product
/// ("Google Play"), so this is what gives a charge its name and makes a missing one visible.
model Subscription {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  name           String
  expectedAmount Float
  /// Day of the month it bills, 1-31; clamped to the month's last day.
  billingDay     Int
  /// Case-insensitive substring of the transaction title that marks a charge. Defaults to `name`.
  matchTitle     String?
  paymentMethod  String?
  note           String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, name])
}

model Expense {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  title         String
  amount        Float
  category      String
  type          String   @default("expense")
  date          DateTime @default(now())
  /// Where the entry came from when it wasn't typed in the app, e.g. "bca-email".
  source        String?
  /// Id in the source system (the Gmail message id for "bca-email"). Makes imports idempotent.
  externalId    String?
  /// How it was paid when that isn't the bank account, e.g. "gopay" or "cash".
  paymentMethod String?
  /// The category is a guess (a transfer to someone new, an unnamed store charge) until the user confirms it.
  needsReview   Boolean  @default(false)
  /// What the source charged when it wasn't rupiah, e.g. 22.2 with originalCurrency "USD". `amount` stays IDR.
  originalAmount   Float?
  /// ISO 4217 code of `originalAmount`, e.g. "USD".
  originalCurrency String?

  @@unique([userId, externalId])
  @@index([userId, date])
}

model VaultKey {
  userId     String   @id
  user       User     @relation(fields: [userId], references: [id])
  salt       String
  iterations Int      @default(600000)
  wrappedKey String
  wrapIv     String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

/// One vault entry. Name, url, username, password and notes are all inside `ciphertext`;
/// the server stores an opaque blob and timestamps, nothing else.
model VaultItem {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  ciphertext String
  iv         String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
}

model Nudge {
  id      String   @id @default(cuid())
  userId  String
  user    User     @relation(fields: [userId], references: [id])
  title   String
  message String
  type    String
  read    Boolean  @default(false)
  sentAt  DateTime @default(now())
}

model PomodoroSession {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  phase     String    @default("focus")
  startedAt DateTime
  endedAt   DateTime?
  createdAt DateTime  @default(now())
}

model PushSubscription {
  id           String @id @default(cuid())
  userId       String @unique
  user         User   @relation(fields: [userId], references: [id])
  subscription String
}

/// An app registered through OAuth dynamic client registration (Claude.ai, Claude Code, …).
/// Public clients only: no secret, PKCE required. `id` is the client_id.
model OAuthClient {
  id           String       @id
  name         String
  redirectUris String[]
  createdAt    DateTime     @default(now())
  codes        OAuthCode[]
  grants       OAuthGrant[]
}

/// A one-time authorization code, valid for minutes. Only its hash is stored.
model OAuthCode {
  id            String      @id @default(cuid())
  codeHash      String      @unique
  clientId      String
  client        OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  redirectUri   String
  scope         String
  codeChallenge String
  resource      String?
  expiresAt     DateTime
  usedAt        DateTime?
  /// The grant this code was exchanged for; revoked if the code is ever presented again.
  grantId       String?
  createdAt     DateTime    @default(now())
}

/// One connected app for one user: what "Connected apps" lists and what Revoke ends. Every access
/// and refresh token issued through it belongs to it.
model OAuthGrant {
  id         String       @id @default(cuid())
  clientId   String
  client     OAuthClient  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  scope      String
  resource   String?
  createdAt  DateTime     @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?
  tokens     OAuthToken[]

  @@index([userId])
}

/// An access token (hour) or refresh token (month). Only the hash is stored.
model OAuthToken {
  id        String     @id @default(cuid())
  tokenHash String     @unique
  /// "access" | "refresh"
  kind      String
  grantId   String
  grant     OAuthGrant @relation(fields: [grantId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime   @default(now())

  @@index([grantId])
}

/// One run of a Claude scheduled task (BCA import, weekly review, ...) as reported by Claude itself
/// through the MCP `report_run` tool. Token counts are Claude's own estimates. No price: the Pro plan
/// doesn't bill per token, and Anthropic publishes no price API to keep a cost figure honest.
model AgentRun {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  /// Which scheduled task, e.g. "BCA import".
  task          String
  model         String?
  status        String   @default("ok")
  /// Tokens in the context window at the end of the run.
  contextTokens Int?
  inputTokens   Int?
  outputTokens  Int?
  summary       String?
  /// Mirrors the MCP client name of the token that reported it.
  client        String?
  createdAt     DateTime @default(now())

  @@index([userId, createdAt])
}
