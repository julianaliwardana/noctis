generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String            @id @default(cuid())
  email            String            @unique
  passwordHash     String
  /// Bumped to revoke every refresh token issued so far (sign out everywhere).
  tokenVersion     Int               @default(0)
  name             String?
  dateOfBirth      DateTime?
  /// Take-home pay per month in IDR, typed in by the user. Powers "can I afford X?".
  monthlyIncome    Float?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  tasks            Task[]
  habits           Habit[]
  expenses         Expense[]
  categories       Category[]
  vaultKey         VaultKey?
  vaultItems       VaultItem[]
  nudges           Nudge[]
  pomodoroSessions PomodoroSession[]
  pushSubscription PushSubscription?
  conversations    Conversation[]
  budgets          Budget[]
  subscriptions    Subscription[]
}

model Conversation {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id])
  title     String
  messages  ChatMessage[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([userId, updatedAt])
}

model ChatMessage {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        String
  actionLabel    String?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

model Task {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  title       String
  notes       String?
  dueAt       DateTime?
  completed   Boolean   @default(false)
  completedAt DateTime?
  recurrence  String?
  createdAt   DateTime  @default(now())
}

model Habit {
  id            String     @id @default(cuid())
  userId        String
  user          User       @relation(fields: [userId], references: [id])
  name          String
  note          String?
  daysOfWeek    Int[]      @default([0, 1, 2, 3, 4, 5, 6])
  endDate       DateTime?
  color         String     @default("#4b8b5f")
  streak        Int        @default(0)
  longestStreak Int        @default(0)
  logs          HabitLog[]
  createdAt     DateTime   @default(now())
}

model HabitLog {
  id        String   @id @default(cuid())
  habitId   String
  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  date      DateTime
  note      String?
  createdAt DateTime @default(now())
}

model Category {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  name      String
  color     String   @default("#2a78d6")
  createdAt DateTime @default(now())
  budget    Budget?

  @@unique([userId, name])
}

/// A standing monthly limit for one category. Deleting the category deletes its budget.
model Budget {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  categoryId      String   @unique
  category        Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  monthlyLimit    Float
  /// Month ("YYYY-MM", Asia/Jakarta) whose 80% push already went out. One push per threshold per month.
  alerted80Month  String?
  alerted100Month String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
}

/// A subscription the user expects to be charged for. Bank titles hide the product
/// ("Google Play"), so this is what gives a charge its name and makes a missing one visible.
model Subscription {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  name           String
  expectedAmount Float
  /// Day of the month it bills, 1-31; clamped to the month's last day.
  billingDay     Int
  /// Case-insensitive substring of the transaction title that marks a charge. Defaults to `name`.
  matchTitle     String?
  paymentMethod  String?
  note           String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, name])
}

model Expense {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  title         String
  amount        Float
  category      String
  type          String   @default("expense")
  date          DateTime @default(now())
  /// Where the entry came from when it wasn't typed in the app, e.g. "bca-email".
  source        String?
  /// Id in the source system (the Gmail message id for "bca-email"). Makes imports idempotent.
  externalId    String?
  /// How it was paid when that isn't the bank account, e.g. "gopay" or "cash".
  paymentMethod String?
  /// The category is a guess (a transfer to someone new, an unnamed store charge) until the user confirms it.
  needsReview   Boolean  @default(false)

  @@unique([userId, externalId])
  @@index([userId, date])
}

model VaultKey {
  userId     String   @id
  user       User     @relation(fields: [userId], references: [id])
  salt       String
  iterations Int      @default(600000)
  wrappedKey String
  wrapIv     String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

/// One vault entry. Name, url, username, password and notes are all inside `ciphertext`;
/// the server stores an opaque blob and timestamps, nothing else.
model VaultItem {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  ciphertext String
  iv         String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
}

model Nudge {
  id      String   @id @default(cuid())
  userId  String
  user    User     @relation(fields: [userId], references: [id])
  title   String
  message String
  type    String
  read    Boolean  @default(false)
  sentAt  DateTime @default(now())
}

model PomodoroSession {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  phase     String    @default("focus")
  startedAt DateTime
  endedAt   DateTime?
  createdAt DateTime  @default(now())
}

model PushSubscription {
  id           String @id @default(cuid())
  userId       String @unique
  user         User   @relation(fields: [userId], references: [id])
  subscription String
}
