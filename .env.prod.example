# Server-only. Copy to `.env` on the Oracle box (docker compose reads it for both
# ${...} interpolation and env_file). Local dev keeps using apps/api/.env + apps/web/.env.local.

TZ=Asia/Jakarta

POSTGRES_USER=noctis
POSTGRES_PASSWORD=
POSTGRES_DB=noctis

# Hostnames are the compose service names, not localhost.
DATABASE_URL=postgresql://noctis:<same-password>@postgres:5432/noctis
REDIS_URL=redis://redis:6379

JWT_SECRET=
WEB_ORIGIN=https://noctis.julianwardana.dev
# Parent of both the web origin and the API, so the session cookies reach each. The API is a
# sibling host, not a subdomain, because Cloudflare's free Universal SSL stops at one level.
COOKIE_DOMAIN=julianwardana.dev

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_MAILTO=mailto:julian.aliwardana@gmail.com

# Chat and nudges both send finance data, so production talks to OmniRoute only. Leave the
# Gemini/Groq/Anthropic keys out of this file: no key, no way to reach those upstreams.
AI_PROVIDER=omniroute

# `noctis` key (server only) + `noctis` combo (Z.ai only). Model = exact id from GET /v1/models.
OMNIROUTE_BASE_URL=https://omniroute.julianwardana.dev/v1
OMNIROUTE_API_KEY=
OMNIROUTE_MODEL=noctis
# Chat model picker, "id=Label,..." — first is the default. Z.ai models only (ids from /v1/models):
# OMNIROUTE_MODELS=noctis=Auto,<glm-4.7-flash id>=GLM-4.7 Flash,<glm-4.5-flash id>=GLM-4.5 Flash
OMNIROUTE_MODELS=noctis=Auto

YOUTUBE_API_KEY=
INNERTUBE_KEY=

# Baked into the browser bundle at image build time.
NEXT_PUBLIC_API_URL=https://noctis-api.julianwardana.dev
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
NEXT_PUBLIC_CDN_URL=https://cdn.julianwardana.dev/Noctis

# From the Cloudflare Zero Trust dashboard when you create the tunnel.
TUNNEL_TOKEN=

# MCP endpoint (/mcp) that lets Claude log transactions, e.g. from BCA notification emails.
# Leave MCP_TOKEN empty to keep the endpoint off. Generate with: openssl rand -hex 32
MCP_TOKEN=
# The Noctis account the MCP tools act as.
MCP_USER_EMAIL=
