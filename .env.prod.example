# Server-only. Copy to `.env` on the Oracle box (docker compose reads it for both
# ${...} interpolation and env_file). Local dev keeps using apps/api/.env + apps/web/.env.local.

TZ=Asia/Jakarta

POSTGRES_USER=noctis
POSTGRES_PASSWORD=
POSTGRES_DB=noctis

# Hostnames are the compose service names, not localhost.
DATABASE_URL=postgresql://noctis:<same-password>@postgres:5432/noctis
REDIS_URL=redis://redis:6379

JWT_SECRET=
WEB_ORIGIN=https://noctis.julianwardana.dev
# Parent of both the web origin and the API, so the session cookies reach each. The API is a
# sibling host, not a subdomain, because Cloudflare's free Universal SSL stops at one level.
COOKIE_DOMAIN=julianwardana.dev

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_MAILTO=mailto:julian.aliwardana@gmail.com

AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# OmniRoute runs on this same box. The api/agent containers can't use localhost — point this at
# the gateway's Tailscale IP (http://100.x.y.z:20128/v1) or its container name on a shared Docker
# network. Model = an id or combo name from GET /v1/models.
OMNIROUTE_BASE_URL=
OMNIROUTE_API_KEY=
OMNIROUTE_MODEL=

YOUTUBE_API_KEY=
INNERTUBE_KEY=

# Baked into the browser bundle at image build time.
NEXT_PUBLIC_API_URL=https://noctis-api.julianwardana.dev
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
NEXT_PUBLIC_CDN_URL=https://cdn.julianwardana.dev/Noctis

# From the Cloudflare Zero Trust dashboard when you create the tunnel.
TUNNEL_TOKEN=
