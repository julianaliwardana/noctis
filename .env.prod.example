# Production env for docker-compose.prod.yml (set in Dokploy → Environment).
# Hostnames are compose service names, not localhost.

TZ=Asia/Jakarta

# Database and Redis
POSTGRES_USER=noctis
POSTGRES_PASSWORD=
POSTGRES_DB=noctis
DATABASE_URL=postgresql://noctis:<POSTGRES_PASSWORD>@postgres:5432/noctis
REDIS_URL=redis://redis:6379

# Auth. JWT_SECRET: at least 32 characters (openssl rand -base64 32).
JWT_SECRET=
WEB_ORIGIN=https://noctis.julianwardana.dev
# Turn on only to create an account, then off again.
ALLOW_REGISTRATION=false
# Expires the old parent-domain cookies. Delete after 2026-12-10.
COOKIE_DOMAIN=julianwardana.dev

# Web Push
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_MAILTO=mailto:julian.aliwardana@gmail.com

# AI: OmniRoute only. Chat and nudges carry finance data, so no other provider keys here.
AI_PROVIDER=omniroute
OMNIROUTE_BASE_URL=https://omniroute.julianwardana.dev/v1
OMNIROUTE_API_KEY=
OMNIROUTE_MODEL=noctis
# Chat picker: id=Label,id=Label (first is the default).
OMNIROUTE_MODELS=noctis=Auto

# YouTube search
YOUTUBE_API_KEY=
INNERTUBE_KEY=

# Web app, baked in at image build. Empty API_INTERNAL_URL means the compose service (http://api:3001).
API_INTERNAL_URL=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
NEXT_PUBLIC_CDN_URL=https://cdn.julianwardana.dev/Noctis

# Cloudflare tunnel token (Zero Trust dashboard)
TUNNEL_TOKEN=

# MCP endpoint with OAuth sign-in (docs/mcp-oauth.md).
# MCP_USER_ID: the Noctis account the MCP tools act as (see DEPLOY.md).
API_PUBLIC_URL=https://noctis-api.julianwardana.dev
WEB_PUBLIC_URL=
MCP_USER_ID=
