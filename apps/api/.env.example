# Database (must match the POSTGRES_* creds in the root .env)
DATABASE_URL="postgresql://user:password@localhost:5432/noctis"

# Redis
REDIS_URL="redis://localhost:6379"

# Auth. Access and refresh tokens share this secret and are told apart by a `type` claim.
# Production requires at least 32 characters.
JWT_SECRET="change-this-to-a-random-32-char-string"

# Session cookies are host-only; the browser reaches this API through the web app's /api rewrite.
# Production only: the parent domain the *old* cookies were set on, so they get expired.
COOKIE_DOMAIN=

# Sign-up is closed unless true. Handy in dev; keep it off in production.
ALLOW_REGISTRATION=true

# Comma-separated origins allowed to call this API.
WEB_ORIGIN="http://localhost:3000"

# Web Push (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_MAILTO="mailto:you@example.com"

# AI provider: omniroute | gemini | groq | claude | ollama
AI_PROVIDER=gemini
GEMINI_API_KEY=
# Optional: pin a version (e.g. gemini-3.6-flash). Defaults to the gemini-flash-latest alias.
GEMINI_MODEL=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# OmniRoute — self-hosted OpenAI-compatible gateway. Base URL includes /v1.
# OMNIROUTE_MODEL is a model id or combo name exactly as GET /v1/models lists it.
# OMNIROUTE_MODELS (optional) is the chat's model picker: "id=Label,id=Label", first = default.
# It is the only list a client can choose from, so keep it to upstreams you trust with finance data.
OMNIROUTE_BASE_URL=https://omniroute.julianwardana.dev/v1
OMNIROUTE_API_KEY=
OMNIROUTE_MODEL=noctis
OMNIROUTE_MODELS=

# YouTube search. Set YOUTUBE_API_KEY for the sanctioned Data API,
# or INNERTUBE_KEY (YouTube's public web-client key) for the keyless fallback.
YOUTUBE_API_KEY=
INNERTUBE_KEY=

# MCP endpoint (/mcp) that lets Claude log transactions, e.g. from BCA notification emails.
# One token per client, as name:token pairs, so a leaked one can be revoked alone.
# Each token at least 32 characters; generate with: openssl rand -hex 32
# Leave both empty to keep the endpoint off. MCP_TOKEN (a single token) still works as client "default".
MCP_TOKENS=
MCP_TOKEN=
# The Noctis account the MCP tools act as. Prefer the id (it survives an email change).
MCP_USER_ID=
MCP_USER_EMAIL=
