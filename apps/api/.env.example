# Database (must match the POSTGRES_* creds in the root .env)
DATABASE_URL="postgresql://user:password@localhost:5432/noctis"

# Redis
REDIS_URL="redis://localhost:6379"

# Auth. Access and refresh tokens share this secret and are told apart by a `type` claim.
JWT_SECRET="change-this-to-a-random-32-char-string"

# Domain the httpOnly session cookies are scoped to — must be a parent of BOTH the web origin
# and this API (e.g. noctis.example.com covers api.noctis.example.com). Leave empty in dev,
# where both sides are localhost and a host-only cookie already reaches both.
COOKIE_DOMAIN=

# Comma-separated origins allowed to call this API.
WEB_ORIGIN="http://localhost:3000"

# Web Push (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_MAILTO="mailto:you@example.com"

# AI provider: omniroute | gemini | groq | claude | ollama
AI_PROVIDER=gemini
GEMINI_API_KEY=
# Optional: pin a version (e.g. gemini-3.6-flash). Defaults to the gemini-flash-latest alias.
GEMINI_MODEL=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# OmniRoute — self-hosted OpenAI-compatible gateway. Base URL includes /v1.
# OMNIROUTE_MODEL is a model id or combo name exactly as GET /v1/models lists it.
# OMNIROUTE_MODELS (optional) is the chat's model picker: "id=Label,id=Label", first = default.
# It is the only list a client can choose from, so keep it to upstreams you trust with finance data.
OMNIROUTE_BASE_URL=https://omniroute.julianwardana.dev/v1
OMNIROUTE_API_KEY=
OMNIROUTE_MODEL=noctis
OMNIROUTE_MODELS=

# YouTube search. Set YOUTUBE_API_KEY for the sanctioned Data API,
# or INNERTUBE_KEY (YouTube's public web-client key) for the keyless fallback.
YOUTUBE_API_KEY=
INNERTUBE_KEY=
