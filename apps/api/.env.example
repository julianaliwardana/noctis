# Copy to apps/api/.env for local dev.

# Database and Redis. DATABASE_URL matches the POSTGRES_* values in the root .env.
DATABASE_URL="postgresql://user:password@localhost:5432/noctis"
REDIS_URL="redis://localhost:6379"
PORT=3001

# Auth. JWT_SECRET: at least 32 characters (openssl rand -base64 32).
JWT_SECRET="change-me-to-a-random-string-of-32-plus-chars"
# Comma-separated origins allowed to call the API.
WEB_ORIGIN="http://localhost:3000"
ALLOW_REGISTRATION=true
# Production only, until 2026-12-10: expires the old parent-domain cookies.
COOKIE_DOMAIN=

# Web Push. Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_MAILTO="mailto:you@example.com"

# AI provider: omniroute | gemini | groq | claude | ollama
AI_PROVIDER=omniroute

# OmniRoute. Model ids come from GET /v1/models.
# OMNIROUTE_MODELS is the optional chat picker: id=Label,id=Label (first is the default).
OMNIROUTE_BASE_URL=https://omniroute.julianwardana.dev/v1
OMNIROUTE_API_KEY=
OMNIROUTE_MODEL=noctis
OMNIROUTE_MODELS=

# Other providers, only for the AI_PROVIDER in use. Empty models use the built-in default.
GEMINI_API_KEY=
GEMINI_MODEL=
GROQ_API_KEY=
GROQ_MODEL=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# YouTube search: the Data API key, or the keyless InnerTube fallback.
# INNERTUBE_MUSIC_KEY defaults to INNERTUBE_KEY.
YOUTUBE_API_KEY=
INNERTUBE_KEY=
INNERTUBE_MUSIC_KEY=

# MCP endpoint (docs/mcp-dev-tools.md). Off while MCP_TOKENS is empty.
# MCP_TOKENS: name:token pairs, comma-separated, each token 32+ chars (openssl rand -hex 32).
# MCP_USER_ID: the Noctis account the MCP tools act as.
MCP_TOKENS=
MCP_USER_ID=

# OAuth sign-in for MCP clients (docs/mcp-oauth.md). Off while API_PUBLIC_URL is empty.
# WEB_PUBLIC_URL defaults to the first WEB_ORIGIN.
API_PUBLIC_URL=
WEB_PUBLIC_URL=
