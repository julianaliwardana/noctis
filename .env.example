# Local dev: copy to .env in the repo root. The api, the agent, the web app, Prisma and the local
# docker compose all read this one file. Production uses .env.prod.example (Dokploy).

# Database and Redis (docker-compose.yml)
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=noctis
DATABASE_URL="postgresql://user:password@localhost:5432/noctis"
REDIS_URL="redis://localhost:6379"
PORT=3001

# Auth. JWT_SECRET: at least 32 characters (openssl rand -base64 32).
JWT_SECRET="change-me-to-a-random-string-of-32-plus-chars"
# Comma-separated origins allowed to call the API.
WEB_ORIGIN="http://localhost:3000"
ALLOW_REGISTRATION=true
# Production only, until 2026-12-10: expires the old parent-domain cookies.
COOKIE_DOMAIN=

# Web Push. Generate with: npx web-push generate-vapid-keys (public key goes in both places)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_MAILTO="mailto:you@example.com"

# AI provider: omniroute | gemini | groq | claude | ollama
AI_PROVIDER=omniroute

# OmniRoute. Model ids come from GET /v1/models.
# OMNIROUTE_MODELS is the optional chat picker: id=Label,id=Label (first is the default).
OMNIROUTE_BASE_URL=https://omniroute.julianwardana.dev/v1
OMNIROUTE_API_KEY=
OMNIROUTE_MODEL=noctis
OMNIROUTE_MODELS=

# Other providers, only for the AI_PROVIDER in use. Empty models use the built-in default.
GEMINI_API_KEY=
GEMINI_MODEL=
GROQ_API_KEY=
GROQ_MODEL=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# YouTube search: the Data API key, or the keyless InnerTube fallback.
# INNERTUBE_MUSIC_KEY defaults to INNERTUBE_KEY.
YOUTUBE_API_KEY=
INNERTUBE_KEY=
INNERTUBE_MUSIC_KEY=

# MCP endpoint with OAuth sign-in (docs/mcp-oauth.md). Off while API_PUBLIC_URL is empty.
# MCP_USER_ID: the Noctis account the MCP tools act as. WEB_PUBLIC_URL defaults to the first WEB_ORIGIN.
API_PUBLIC_URL=
WEB_PUBLIC_URL=
MCP_USER_ID=

# Web app. Empty API_INTERNAL_URL means http://localhost:3001.
API_INTERNAL_URL=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
NEXT_PUBLIC_CDN_URL=https://cdn.julianwardana.dev/Noctis
